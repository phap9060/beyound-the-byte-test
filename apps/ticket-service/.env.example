PORT=4001
DATABASE_URL=file:./data/tickets.db

# Obrigatório no deploy (mín. 16 caracteres). Sem ele, o serviço aceita qualquer chamada.
# TICKET_SERVICE_TOKEN=

# Instabilidade simulada do sistema legado. Tudo 0 = desligada.
CHAOS_FAILURE_RATE=0.05
CHAOS_LATENCY_MS=100-400
CHAOS_OUTAGE_RATE=0.01
CHAOS_OUTAGE_MS=4000
