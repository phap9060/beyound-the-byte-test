DATABASE_URL=file:./data/app.db
TICKET_SERVICE_URL=http://localhost:4001
# Igual ao do ticket-service, quando ele estiver configurado.
# TICKET_SERVICE_TOKEN=

# Obrigatório em produção (mínimo de 32 caracteres). Ex.: openssl rand -base64 32
# SESSION_SECRET=

# Modelo do agent (Google AI Studio, plano gratuito): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcional. Padrão: gemini-3.5-flash-lite
# AI_MODEL=
# Limites de uso do agent (custo e abuso). O padrão de 6 por minuto cabe no plano gratuito.
# AI_TURNS_PER_MINUTE=6
# AI_TURNS_PER_USER_HOUR=40
# AI_TURNS_PER_DAY=500
# Desliga a telemetria anônima do Mastra.
MASTRA_TELEMETRY_DISABLED=1
