{
  "name": "@nexo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node -e \"require('node:fs').rmSync('data', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@nexo/domain": "workspace:*",
    "@nexo/ticket-client": "workspace:*",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "vitest": "5.1.0"
  }
}
